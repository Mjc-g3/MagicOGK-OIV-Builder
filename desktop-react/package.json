{
  "name": "magicogk-oiv-studio",
  "version": "2.0.0-alpha.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "pack:win": "npm run build && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.11",
    "jszip": "^3.10.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^6.1.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.magicogk.oivstudio",
    "productName": "MagicOGK OIV Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  },
  "description": "React desktop editor for OpenIV packages",
  "author": "MagicOGK"
}
